---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BlogExplorer from '../../components/BlogExplorer.astro';

const modules = import.meta.glob('./*/index.md', { eager: true }) as Record<string, any>;

const posts = Object.values(modules)
  .map((post) => {
    const fm = post.frontmatter ?? {};
    return {
      title: fm.title,
      description: fm.description,
      date: new Date(fm.pubDate),
      href: fm.enPath,
      tags: fm.tags ?? [],
      category: fm.category ?? 'Uncategorized'
    };
  })
  .filter((post) => post.title && post.href && !Number.isNaN(post.date.getTime()))
  .sort((a, b) => b.date.getTime() - a.date.getTime());
---

<BaseLayout
  title="Infrastructure Troubleshooting Guides | InfraOpsX"
  description="Practical technical notes about Linux, Docker, Kubernetes and infrastructure troubleshooting."
  lang="en"
  canonicalPath="/blog/"
  enPath="/blog/"
  zhPath="/zh/blog/"
>
  <Header locale="en" switchHref="/zh/blog/" />

  <main>
    <section class="blog-hero">
      <div class="container">
        <div class="blog-title-row">
          <div>
            <span class="section-label">TECHNICAL ARTICLES</span>
            <h1>Real problems. Practical notes.</h1>
          </div>

          <a class="rss-link" href="/rss.xml">
            RSS Feed ↗
          </a>
        </div>

        <p>
          Troubleshooting notes, deployment guides and anonymized infrastructure
          case studies from Linux, Docker, Kubernetes, networking and storage.
        </p>
      </div>
    </section>

    <section class="section" data-seo-entry-links aria-labelledby="blog-paths-heading">
      <div class="container">
        <div class="section-heading">
          <span class="section-label">FIND YOUR SYMPTOM</span>
          <h2 id="blog-paths-heading">Start with the failure you can observe.</h2>
          <p>These guides distinguish observations from assumptions and include the commands used to narrow the issue.</p>
        </div>
        <div class="cards">
          <article class="card">
            <h3><a href="/blog/kubernetes-pod-pending/">Pod Pending and FailedScheduling →</a></h3>
            <p>Read scheduler events and distinguish resource pressure from affinity or node-selection constraints.</p>
          </article>
          <article class="card">
            <h3><a href="/blog/kubernetes-ceph-rbd-high-iowait-latency/">High iowait with low disk throughput →</a></h3>
            <p>Trace blocked tasks from a Kubernetes node through RBD devices and Ceph OSD latency without assuming a physical root cause.</p>
          </article>
          <article class="card">
            <h3><a href="/blog/postgresql-pg-wal-growth-patroni-replication-lag/">PostgreSQL pg_wal keeps growing →</a></h3>
            <p>Check replication lag, slot retention and archiving before changing WAL settings or deleting files.</p>
          </article>
        </div>
      </div>
    </section>

    <BlogExplorer posts={posts} locale="en" />
  </main>

  <Footer locale="en" />
</BaseLayout>
