---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import BlogExplorer from '../../../components/BlogExplorer.astro';

const modules = import.meta.glob('./*/index.md', { eager: true }) as Record<string, any>;

const posts = Object.values(modules)
  .map((post) => {
    const fm = post.frontmatter ?? {};
    return {
      title: fm.title,
      description: fm.description,
      date: new Date(fm.pubDate),
      href: fm.zhPath,
      tags: fm.tags ?? [],
      category: fm.category ?? 'Uncategorized'
    };
  })
  .filter((post) => post.title && post.href && !Number.isNaN(post.date.getTime()))
  .sort((a, b) => b.date.getTime() - a.date.getTime());
---

<BaseLayout
  title="技术文章 | InfraOpsX"
  description="Linux、Docker、Kubernetes 与基础设施故障排查相关的实用技术记录。"
  lang="zh-CN"
  canonicalPath="/zh/blog/"
  enPath="/blog/"
  zhPath="/zh/blog/"
>
  <Header locale="zh" switchHref="/blog/" />

  <main>
    <section class="blog-hero">
      <div class="container">
        <div class="blog-title-row">
          <div>
            <span class="section-label">技术文章</span>
            <h1>真实问题，实用记录。</h1>
          </div>

          <a class="rss-link" href="/zh/rss.xml">
            RSS 订阅 ↗
          </a>
        </div>

        <p>
          记录 Linux、Docker、Kubernetes、网络、存储和生产环境中的
          故障排查、部署实践以及匿名化案例。
        </p>
      </div>
    </section>

    <BlogExplorer posts={posts} locale="zh" />
  </main>

  <Footer locale="zh" />
</BaseLayout>
