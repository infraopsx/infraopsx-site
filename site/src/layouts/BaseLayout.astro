---
import '../styles/global.css';

type PagefindType = 'Article' | 'Tool' | 'Case Study' | 'Portfolio';

const {
  title = 'InfraOpsX',
  description = 'Linux, Docker, Kubernetes and infrastructure engineering.',
  lang = 'en',
  canonicalPath = '/',
  enPath = '/',
  zhPath = '/zh/',
  pagefindType,
  noindex = false
} = Astro.props as {
  title?: string;
  description?: string;
  lang?: string;
  canonicalPath?: string;
  enPath?: string;
  zhPath?: string;
  pagefindType?: PagefindType;
  noindex?: boolean;
};

const site = 'https://infra.oeax.de';

const canonicalUrl = new URL(canonicalPath, site).toString();
const enUrl = new URL(enPath, site).toString();
const zhUrl = new URL(zhPath, site).toString();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{title}</title>
    <meta
      name="description"
      content={description}
      data-pagefind-default-meta="description[content]"
    />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <meta name="theme-color" content="#07111f" />

    <link rel="canonical" href={canonicalUrl} />

    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="zh-CN" href={zhUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={lang === 'zh-CN' ? 'InfraOpsX 技术文章' : 'InfraOpsX Technical Articles'}
      href={lang === 'zh-CN' ? '/zh/rss.xml' : '/rss.xml'}
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="InfraOpsX" />

    <meta name="twitter:card" content="summary" />
  </head>

  <body
    data-pagefind-filter={pagefindType ? `type:${pagefindType}` : undefined}
    data-pagefind-meta={pagefindType ? `type:${pagefindType}` : undefined}
  >
    <slot />
  </body>
</html>
