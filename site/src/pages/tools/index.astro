---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout
  title="Infrastructure Tools | InfraOpsX"
  description="Practical browser-based tools for Ceph, Kubernetes and infrastructure planning."
  lang="en"
  canonicalPath="/tools/"
  enPath="/tools/"
  zhPath="/zh/tools/"
>
  <Header locale="en" switchHref="/zh/tools/" />

  <main>
    <section class="tools-hero">
      <div class="container">
        <div class="tools-breadcrumb">
          <a href="/">Home</a>
          <span>/</span>
          <span>Tools</span>
        </div>

        <span class="section-label">INFRAOPSX TOOLS</span>
        <h1>Practical infrastructure tools for real-world systems.</h1>
        <p>Small, practical tools for storage and Kubernetes planning.</p>
      </div>
    </section>

    <section class="tools-section">
      <div class="container">
        <div class="tools-grid">
          <a class="tool-card tool-card-active" href="/tools/ceph-capacity-calculator/">
            <span class="tool-card-number">01</span>
            <h2>Ceph Capacity Calculator</h2>
            <p>Estimate raw capacity, theoretical usable capacity, and reserve headroom for replicated and erasure-coded Ceph layouts.</p>
            <span class="tool-card-link">Open calculator →</span>
          </a>

          <a class="tool-card tool-card-active" href="/tools/kubernetes-resource-calculator/">
            <span class="tool-card-number">02</span>
            <h2>Kubernetes Resource Calculator</h2>
            <p>Plan CPU and memory requests, limits, node capacity, and Pod density for a homogeneous Kubernetes node pool.</p>
            <span class="tool-card-link">Open calculator →</span>
          </a>

          <article class="tool-card tool-card-muted">
            <span class="tool-card-number">03</span>
            <span class="tool-status">COMING SOON</span>
            <h2>Kubernetes Quantity Converter</h2>
            <p>Convert Kubernetes resource quantities into readable values and units.</p>
          </article>
        </div>
      </div>
    </section>
  </main>

  <Footer locale="en" />
</BaseLayout>
