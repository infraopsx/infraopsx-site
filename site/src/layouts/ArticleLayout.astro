---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const { frontmatter, headings = [] } = Astro.props;

const {
  title,
  description,
  pubDate,
  category = 'Uncategorized',
  tags = [],
  locale: frontmatterLocale,
  enPath,
  zhPath
} = frontmatter;

const currentPath = Astro.url.pathname;

const locale =
  frontmatterLocale ??
  (currentPath.startsWith('/zh/') ? 'zh-CN' : 'en');

const isZh = locale === 'zh-CN';

const formattedDate = new Intl.DateTimeFormat(
  isZh ? 'zh-CN' : 'en-US',
  {
    year: 'numeric',
    month: isZh ? 'long' : 'short',
    day: 'numeric'
  }
).format(new Date(pubDate));

const categoryLabels: Record<string, string> = isZh
  ? {
      Kubernetes: 'Kubernetes',
      Databases: '数据库',
      Storage: '存储',
      Linux: 'Linux',
      Networking: '网络',
      Observability: '可观测性',
      'Docker & Containers': 'Docker / 容器',
      Uncategorized: '未分类'
    }
  : {};

const displayCategory = categoryLabels[category] ?? category;
const switchHref = isZh ? enPath : zhPath;

const site = 'https://infra.oeax.de';
const canonicalUrl = new URL(currentPath, site).toString();
const homeUrl = new URL(isZh ? '/zh/' : '/', site).toString();
const articlesUrl = new URL(isZh ? '/zh/blog/' : '/blog/', site).toString();
const datePublished =
  pubDate instanceof Date
    ? pubDate.toISOString().slice(0, 10)
    : String(pubDate);

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      headline: title,
      description,
      datePublished,
      inLanguage: locale,
      url: canonicalUrl,
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': canonicalUrl
      },
      publisher: {
        '@type': 'Organization',
        name: 'InfraOpsX',
        url: site
      }
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: isZh ? '首页' : 'Home',
          item: homeUrl
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: isZh ? '技术文章' : 'Articles',
          item: articlesUrl
        }
      ]
    }
  ]
};

const tocHeadings = headings.filter(
  (heading: { depth: number; slug: string; text: string }) =>
    heading.depth === 2
);
const showToc = tocHeadings.length >= 4;
---

<BaseLayout
  title={`${title} | InfraOpsX`}
  description={description}
  lang={locale}
  canonicalPath={currentPath}
  enPath={enPath}
  zhPath={zhPath}
  pagefindType="Article"
  ogType="article"
  structuredData={structuredData}
>
  <Header
    locale={isZh ? 'zh' : 'en'}
    switchHref={switchHref}
  />

  <main class="article-shell" data-pagefind-body>
    <div class="container article-container">

      <div class="article-breadcrumb" data-pagefind-ignore>
        <a href={isZh ? '/zh/' : '/'}>
          {isZh ? '首页' : 'Home'}
        </a>

        <span>/</span>

        <a href={isZh ? '/zh/blog/' : '/blog/'}>
          {isZh ? '技术文章' : 'Articles'}
        </a>
      </div>

      <header class="article-header">
        <div class="article-meta">
          <span data-pagefind-meta="date">{formattedDate}</span>
          <span>·</span>
          <span
            data-pagefind-filter={`category:${category}`}
            data-pagefind-meta={`category:${category}`}
          >
            {displayCategory}
          </span>
        </div>

        <h1 data-pagefind-meta="title">{title}</h1>

        <p data-pagefind-meta="description">{description}</p>

        <div class="article-tags">
          {tags.map((tag) => (
            <span data-pagefind-filter="tag">{tag}</span>
          ))}
        </div>

        {switchHref && (
          <a
            class="article-language"
            href={switchHref}
            data-pagefind-ignore
          >
            {isZh ? 'Read in English →' : '阅读中文版 →'}
          </a>
        )}
      </header>

      <article class="article-content">
        {showToc && (
          <nav
            class="article-toc"
            aria-label={isZh ? '本文目录' : 'Table of contents'}
            data-pagefind-ignore
          >
            <div class="article-toc-title">
              {isZh ? '本文目录' : 'Table of contents'}
            </div>
            <ol>
              {tocHeadings.map(
                (heading: { depth: number; slug: string; text: string }) => (
                  <li>
                    <a href={`#${heading.slug}`}>{heading.text}</a>
                  </li>
                )
              )}
            </ol>
          </nav>
        )}

        <slot />
      </article>

      <div class="article-footer-nav" data-pagefind-ignore>
        <a href={isZh ? '/zh/blog/' : '/blog/'}>
          ← {isZh ? '返回技术文章' : 'Back to articles'}
        </a>
      </div>

    </div>
  </main>

  <Footer locale={isZh ? 'zh' : 'en'} />
</BaseLayout>

<style>
  .article-toc {
    display: block;
    margin: 0 0 48px;
    padding: 24px 26px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--panel-subtle);
  }

  .article-toc-title {
    color: var(--text);
    font-size: 14px;
    font-weight: 700;
  }

  .article-toc ol {
    columns: 2;
    column-gap: 36px;
    margin: 16px 0 0;
    padding-left: 22px;
  }

  .article-toc li {
    break-inside: avoid;
    margin: 7px 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.55;
  }

  .article-toc a {
    color: inherit;
    font-size: inherit;
    text-decoration: none;
  }

  .article-toc a:hover {
    color: var(--cyan);
  }

  @media (max-width: 600px) {
    .article-toc {
      padding: 20px;
    }

    .article-toc ol {
      columns: 1;
    }
  }
</style>
