---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const cases = [
  {
    title: 'Kubernetes 调度失败定位',
    area: 'Kubernetes · 调度',
    problem: '某个工作负载长时间处于 Pending，在一个 6 节点集群中始终无法完成调度。',
    diagnosis: 'Scheduler Events 显示：2 个节点因 Affinity 规则被排除，另外 4 个节点因 CPU Request 无法满足而被排除。',
    outcome: '把一个笼统的 Pending 问题缩小成了几个明确的调度约束，从而能够针对真正原因采取措施。',
    href: '/zh/case-studies/kubernetes-pod-pending/'
  },
  {
    title: 'Rook Ceph RBD FailedMount 恢复',
    area: 'Kubernetes · Rook Ceph · 存储',
    problem: '某个有状态 Pod 卡在 ContainerCreating，CSI 持续提示 RBD image is still being used。',
    diagnosis: '扫描所有 RBD nodeplugin 后，在对应的 CSI nodeplugin 中找到目标 image 的 mapping。',
    outcome: '记录中的 mount 检查、umount 和 RBD unmap 完成后，CSI 重新 map volume，Pod 恢复。',
    href: '/zh/case-studies/rook-ceph-rbd-failedmount/'
  },
  {
    title: 'Patroni 副本延迟与 PostgreSQL WAL 保留',
    area: 'PostgreSQL · Patroni · 复制',
    problem: 'Patroni 的一个副本落后约 230 GiB，同时 pg_wal 目录占用持续较高。',
    diagnosis: '区分已经观察到的副本延迟与仍需验证的 WAL 保留机制，重点检查复制槽、归档和相关配置。',
    outcome: '记录用于判断下一步的核查方法，不把副本延迟本身直接当成 WAL 被保留的唯一根因。',
    href: '/zh/blog/postgresql-pg-wal-growth-patroni-replication-lag/'
  },
  {
    title: 'Kubernetes 高 iowait 与 Ceph RBD 延迟定位',
    area: 'Kubernetes · Ceph RBD · 性能',
    problem: 'Kubernetes 节点 iowait 较高，但本地磁盘的吞吐量不明显。',
    diagnosis: '通过 D 状态线程、CSI 映射、iostat 与 OSD 指标，将延迟追踪到 RBD 到 OSD 的存储路径。',
    outcome: '已有证据证明 Ceph 路径存在延迟，但无法确认宿主机或物理存储的最终根因。',
    href: '/zh/blog/kubernetes-ceph-rbd-high-iowait-latency/'
  }
];
---

<BaseLayout
  title="Kubernetes、Ceph 与 PostgreSQL 故障排查案例 | InfraOpsX"
  description="Kubernetes、PostgreSQL、Ceph、Docker 与 Linux 基础设施故障排查的匿名化真实案例。"
  lang="zh-CN"
  canonicalPath="/zh/case-studies/"
  enPath="/case-studies/"
  zhPath="/zh/case-studies/"
>
  <Header locale="zh" switchHref="/case-studies/" />

  <main>
    <section class="showcase-hero">
      <div class="container">
        <span class="section-label">案例</span>
        <h1>真实故障如何一步步缩小排查范围。</h1>
        <p>
          这些内容来自真实基础设施工作的匿名化整理。重点不是公司名或环境名称，
          而是现场证据、排查步骤、已确认的结论以及仍无法确定的部分。
        </p>
      </div>
    </section>

    <section class="showcase-section" data-seo-entry-links>
      <div class="container showcase-grid">
        {cases.map((item, index) => (
          <article class={`showcase-card ${item.href ? 'showcase-card-linked' : ''}`}>
            <div class="showcase-kicker">0{index + 1} · {item.area}</div>
            <h2>{item.title}</h2>

            <div class="case-block">
              <span>问题</span>
              <p>{item.problem}</p>
            </div>

            <div class="case-block">
              <span>排查</span>
              <p>{item.diagnosis}</p>
            </div>

            <div class="case-block">
              <span>结果</span>
              <p>{item.outcome}</p>
            </div>

            {item.href && (
              <a class="case-read-more" href={item.href}>
                查看完整排查记录 →
              </a>
            )}
          </article>
        ))}
      </div>
    </section>
  </main>

  <Footer locale="zh" />
</BaseLayout>
