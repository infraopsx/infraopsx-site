---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ToolsExplorer from '../../../components/tools/ToolsExplorer.astro';
---

<BaseLayout
  title="基础设施工具 | InfraOpsX"
  description="面向 Ceph、Kubernetes 和基础设施容量规划的实用浏览器工具。"
  lang="zh-CN"
  canonicalPath="/zh/tools/"
  enPath="/tools/"
  zhPath="/zh/tools/"
>
  <Header locale="zh" switchHref="/tools/" />

  <main>
    <section class="tools-hero">
      <div class="container">
        <div class="tools-breadcrumb">
          <a href="/zh/">首页</a>
          <span>/</span>
          <span>工具</span>
        </div>

        <span class="section-label">INFRAOPSX 工具</span>
        <h1>面向真实基础设施的实用工具。</h1>
        <p>用于存储和 Kubernetes 规划的小型实用计算器。</p>
      </div>
    </section>

    <ToolsExplorer locale="zh" />
  </main>

  <Footer locale="zh" />
</BaseLayout>
