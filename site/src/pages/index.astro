---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const services = [
  {
    title: 'Docker & Self-hosted Deployment',
    text: 'Deploy or migrate containerized and self-hosted applications with Docker and Docker Compose, including persistent storage, reverse proxy configuration and HTTPS.'
  },
  {
    title: 'Kubernetes Deployment & Troubleshooting',
    text: 'Deploy and troubleshoot Kubernetes workloads, including scheduling, resource settings, services, ingress and CSI-backed storage.'
  },
  {
    title: 'Linux & Infrastructure Troubleshooting',
    text: 'Diagnose Linux and infrastructure issues involving services, filesystems, disk I/O, storage and networking by examining logs, metrics and system state.'
  },
  {
    title: 'Monitoring & Observability',
    text: 'Build practical Prometheus and Grafana monitoring that makes server, container and infrastructure metrics easier to understand.'
  }
];

const skills = [
  'Linux',
  'Docker',
  'Docker Compose',
  'Kubernetes',
  'Nginx',
  'Networking',
  'Storage',
  'Prometheus',
  'Grafana',
  'Infrastructure'
];
---

<BaseLayout
  title="InfraOpsX | Linux, Docker & Kubernetes Infrastructure"
  description="Practical Linux, Docker, Kubernetes, deployment and infrastructure engineering."
  lang="en"
  canonicalPath="/"
  enPath="/"
  zhPath="/zh/"
>
  <Header locale="en" />

  <main>
    <section class="hero">
      <div class="hero-glow"></div>

      <div class="container hero-content">
        <div class="eyebrow">
          Linux · Docker · Kubernetes · Infrastructure
        </div>

        <h1>
          Infrastructure that stays
          <span>understandable.</span>
        </h1>

        <p class="hero-text">
          Practical deployment, troubleshooting and infrastructure solutions
          for Linux servers, containers, Kubernetes and self-hosted systems.
        </p>

        <div class="hero-actions">
          <a class="button primary" href="#services">View services</a>
          <a class="button secondary" href="#articles">Technical articles</a>
        </div>

        <div class="stack">
          <span>Linux</span>
          <span>Docker</span>
          <span>Kubernetes</span>
          <span>Nginx</span>
          <span>Prometheus</span>
          <span>Grafana</span>
        </div>
      </div>
    </section>

    <section id="services" class="section">
      <div class="container">
        <div class="section-heading">
          <span class="section-label">SERVICES</span>
          <h2>Infrastructure work with a clear outcome.</h2>
          <p>
            Focused on practical deployment and operations rather than unnecessary complexity.
          </p>
        </div>

        <div class="cards">
          {services.map((service, index) => (
            <article class="card">
              <div class="card-number">0{index + 1}</div>
              <h3>{service.title}</h3>
              <p>{service.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="expertise" class="section section-dark">
      <div class="container split">
        <div>
          <span class="section-label">EXPERTISE</span>
          <h2>Built around real infrastructure.</h2>

          <p class="large-copy">
            I work across Linux systems, containers, Kubernetes, networking,
            storage and monitoring. A key part of that work is tracing issues
            across layers using logs, metrics and system state, then making
            focused changes that keep production systems understandable and maintainable.
          </p>
        </div>

        <div class="skill-grid">
          {skills.map((skill) => (
            <div class="skill">{skill}</div>
          ))}
        </div>
      </div>
    </section>

    <section id="work" class="section">
      <div class="container">
        <div class="section-heading">
          <span class="section-label">HOW I WORK</span>
          <h2>Diagnose first. Change second.</h2>
        </div>

        <div class="workflow">
          <div>
            <strong>01</strong>
            <h3>Understand</h3>
            <p>Start from the actual requirement, environment and constraints.</p>
          </div>

          <div>
            <strong>02</strong>
            <h3>Diagnose</h3>
            <p>Use logs, metrics and system state to identify the real cause.</p>
          </div>

          <div>
            <strong>03</strong>
            <h3>Implement</h3>
            <p>Apply the smallest reliable solution with clear configuration.</p>
          </div>

          <div>
            <strong>04</strong>
            <h3>Verify</h3>
            <p>Validate the result and leave the environment understandable.</p>
          </div>
        </div>
      </div>
    </section>

    <section id="articles" class="section section-accent">
      <div class="container articles-intro">
        <div>
          <span class="section-label">TECHNICAL NOTES</span>
          <h2>Real problems. Practical notes.</h2>

          <p>
            Practical troubleshooting notes from real Linux, Kubernetes, storage
            and database incidents, with commands, evidence and diagnosis paths
            that can be reused in similar environments.
          </p>
        </div>

        <div class="article-preview">
          <span>SELECTED ARTICLES</span>

          <ul>
            <li>
              <a href="/blog/kubernetes-ceph-rbd-high-iowait-latency/">
                Kubernetes High iowait, Low Throughput: Ceph RBD/OSD Latency
              </a>
            </li>
            <li>
              <a href="/blog/rook-ceph-rbd-image-still-being-used-failedmount/">
                Kubernetes + Rook Ceph: Troubleshooting FailedMount 'RBD image is still being used'
              </a>
            </li>
            <li>
              <a href="/blog/postgresql-pg-wal-growth-patroni-replication-lag/">
                Why PostgreSQL pg_wal Keeps Growing: Patroni Replication Lag and Replication Slot Troubleshooting
              </a>
            </li>
          </ul>

          <p class="article-all"><a href="/blog/">Browse all articles →</a></p>
        </div>
      </div>
    </section>

    <section class="cta">
      <div class="container">
        <div class="cta-box">
          <div>
            <span class="section-label">INFRAOPSX</span>
            <h2>Deployment should be boring.</h2>
            <p>Reliable systems, clear configuration and practical operations.</p>
          </div>

          <div class="cta-actions">
            <div class="status">
              <span class="status-dot"></span>
              Project-based work
            </div>
            <a class="button primary" href="/contact/">Contact →</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer locale="en" />
</BaseLayout>
