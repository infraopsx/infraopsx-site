---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const { frontmatter, headings = [] } = Astro.props;

const {
  title,
  description,
  pubDate,
  updatedDate,
  category = 'Uncategorized',
  tags = [],
  locale: frontmatterLocale,
  enPath,
  zhPath
} = frontmatter;

const currentPath = Astro.url.pathname;

const locale =
  frontmatterLocale ??
  (currentPath.startsWith('/zh/') ? 'zh-CN' : 'en');

const isZh = locale === 'zh-CN';

const dateFormatter = new Intl.DateTimeFormat(
  isZh ? 'zh-CN' : 'en-US',
  {
    year: 'numeric',
    month: isZh ? 'long' : 'short',
    day: 'numeric'
  }
);

const formattedDate = dateFormatter.format(new Date(pubDate));
const formattedUpdatedDate = updatedDate
  ? dateFormatter.format(new Date(updatedDate))
  : null;

const categoryLabels: Record<string, string> = isZh
  ? {
      Kubernetes: 'Kubernetes',
      Databases: '数据库',
      Storage: '存储',
      Linux: 'Linux',
      Networking: '网络',
      Observability: '可观测性',
      'Docker & Containers': 'Docker / 容器',
      Uncategorized: '未分类'
    }
  : {};

const displayCategory = categoryLabels[category] ?? category;
const switchHref = isZh ? enPath : zhPath;

const site = 'https://infra.oeax.de';
const canonicalUrl = new URL(currentPath, site).toString();
const homeUrl = new URL(isZh ? '/zh/' : '/', site).toString();
const articlesUrl = new URL(isZh ? '/zh/blog/' : '/blog/', site).toString();
const authorHref = isZh ? '/zh/about/' : '/about/';
const authorUrl = new URL('/about/', site).toString();
const ogImagePath = '/og-default.png';
const ogImageUrl = new URL(ogImagePath, site).toString();
const datePublished =
  pubDate instanceof Date
    ? pubDate.toISOString().slice(0, 10)
    : String(pubDate);
const dateModified = updatedDate
  ? updatedDate instanceof Date
    ? updatedDate.toISOString().slice(0, 10)
    : String(updatedDate)
  : undefined;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      headline: title,
      description,
      datePublished,
      dateModified,
      image: ogImageUrl,
      inLanguage: locale,
      url: canonicalUrl,
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': canonicalUrl
      },
      author: {
        '@type': 'Organization',
        name: 'InfraOpsX',
        url: authorUrl
      },
      publisher: {
        '@type': 'Organization',
        name: 'InfraOpsX',
        url: site
      }
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: isZh ? '首页' : 'Home',
          item: homeUrl
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: isZh ? '技术文章' : 'Articles',
          item: articlesUrl
        }
      ]
    }
  ]
};

const tocHeadings = headings.filter(
  (heading: { depth: number; slug: string; text: string }) =>
    heading.depth === 2
);
const showToc = tocHeadings.length >= 4;
const tocHasExplicitNumbers = tocHeadings.some(
  (heading: { text: string }) => /^\d+[.)]\s+/.test(heading.text)
);
---

<BaseLayout
  title={`${title} | InfraOpsX`}
  description={description}
  lang={locale}
  canonicalPath={currentPath}
  enPath={enPath}
  zhPath={zhPath}
  pagefindType="Article"
  ogType="article"
  ogImage={ogImagePath}
  structuredData={structuredData}
>
  <Header
    locale={isZh ? 'zh' : 'en'}
    switchHref={switchHref}
  />

  <main class="article-shell" data-pagefind-body>
    <div class="container article-container">

      <div class="article-breadcrumb" data-pagefind-ignore>
        <a href={isZh ? '/zh/' : '/'}>
          {isZh ? '首页' : 'Home'}
        </a>

        <span>/</span>

        <a href={isZh ? '/zh/blog/' : '/blog/'}>
          {isZh ? '技术文章' : 'Articles'}
        </a>
      </div>

      <header class="article-header">
        <div class="article-meta">
          <span data-pagefind-meta="date">
            {updatedDate
              ? isZh
                ? `发布于 ${formattedDate} · 更新于 ${formattedUpdatedDate}`
                : `Published ${formattedDate} · Updated ${formattedUpdatedDate}`
              : formattedDate}
          </span>
          <span>·</span>
          <span
            data-pagefind-filter={`category:${category}`}
            data-pagefind-meta={`category:${category}`}
          >
            {displayCategory}
          </span>
          <span>·</span>
          <span class="article-author" data-pagefind-ignore>
            {isZh ? '作者：' : 'By '}
            <a href={authorHref}>InfraOpsX</a>
          </span>
        </div>

        <h1 data-pagefind-meta="title">{title}</h1>

        <p data-pagefind-meta="description">{description}</p>

        <div class="article-tags">
          {tags.map((tag) => (
            <span data-pagefind-filter="tag">{tag}</span>
          ))}
        </div>

        {switchHref && (
          <a
            class="article-language"
            href={switchHref}
            data-pagefind-ignore
          >
            {isZh ? 'Read in English →' : '阅读中文版 →'}
          </a>
        )}
      </header>

      <article class="article-content">
        {showToc && (
          <nav
            class="article-toc"
            aria-label={isZh ? '本文目录' : 'Table of contents'}
            data-pagefind-ignore
          >
            <div class="article-toc-title">
              {isZh ? '本文目录' : 'Table of contents'}
            </div>
            <ol class={tocHasExplicitNumbers ? 'has-explicit-numbers' : undefined}>
              {tocHeadings.map(
                (heading: { depth: number; slug: string; text: string }) => (
                  <li>
                    <a href={`#${heading.slug}`}>{heading.text}</a>
                  </li>
                )
              )}
            </ol>
          </nav>
        )}

        <slot />
      </article>


      <aside class="article-support" data-pagefind-ignore>
        <div>
          <h2>
            {isZh
              ? '支持 InfraOpsX — $3/月'
              : 'Support InfraOpsX — $3/month'}
          </h2>
          <p>
            {isZh
              ? '支持 InfraOpsX 工具和技术文章的持续维护。这是 Patreon 每月循环订阅，InfraOpsX 的文章和工具仍然免费开放。'
              : 'Support the continued maintenance of InfraOpsX tools and technical guides. This is a recurring monthly Patreon membership. InfraOpsX articles and tools remain free.'}
          </p>
        </div>
        <a
          class="article-support-link"
          href="https://www.patreon.com/infraopsx"
          target="_blank"
          rel="noopener noreferrer"
        >
          {isZh ? '通过 Patreon 支持 →' : 'Support on Patreon →'}
        </a>
      </aside>

      <div class="article-footer-nav" data-pagefind-ignore>
        <a href={isZh ? '/zh/blog/' : '/blog/'}>
          ← {isZh ? '返回技术文章' : 'Back to articles'}
        </a>
      </div>

    </div>
  </main>

  <Footer locale={isZh ? 'zh' : 'en'} />
<script is:inline>
  (() => {
    const copyText = async (text) => {
      if (navigator.clipboard?.writeText) {
        await navigator.clipboard.writeText(text);
        return;
      }

      const textarea = document.createElement('textarea');
      textarea.value = text;
      textarea.setAttribute('readonly', '');
      textarea.style.position = 'fixed';
      textarea.style.opacity = '0';
      document.body.appendChild(textarea);
      textarea.select();
      document.execCommand('copy');
      textarea.remove();
    };

    const initCodeCopyButtons = () => {
      const isZh = document.documentElement.lang === 'zh-CN';

      document.querySelectorAll('.article-content pre').forEach((pre) => {
        if (pre.querySelector('.code-copy-button')) return;

        const code = pre.querySelector('code');
        if (!code) return;

        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'code-copy-button';
        button.textContent = isZh ? '复制' : 'Copy';
        button.setAttribute('aria-label', isZh ? '复制代码' : 'Copy code');

        button.addEventListener('click', async () => {
          const original = isZh ? '复制' : 'Copy';

          try {
            await copyText(code.innerText);
            button.textContent = isZh ? '已复制' : 'Copied';
          } catch {
            button.textContent = isZh ? '复制失败' : 'Copy failed';
          }

          window.setTimeout(() => {
            button.textContent = original;
          }, 1600);
        });

        pre.appendChild(button);
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCodeCopyButtons, { once: true });
    } else {
      initCodeCopyButtons();
    }
  })();
</script>

</BaseLayout>

<style>
  .article-author a {
    color: inherit;
    text-decoration: none;
  }

  .article-author a:hover,
  .article-author a:focus-visible {
    color: var(--cyan);
  }


  .article-support {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 28px;
    margin-top: 64px;
    padding: 28px 30px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--panel-subtle);
  }

  .article-support h2 {
    margin: 0 0 8px;
    color: var(--text);
    font-size: 20px;
    line-height: 1.3;
  }

  .article-support p {
    max-width: 680px;
    margin: 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.7;
  }

  .article-support-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    padding: 10px 15px;
    border: 1px solid var(--accent-border);
    border-radius: 8px;
    background: var(--accent-soft-bg);
    color: var(--accent-text);
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  .article-support-link:hover,
  .article-support-link:focus-visible {
    border-color: var(--cyan);
    color: var(--strong-text);
  }

  .article-toc {
    display: block;
    margin: 0 0 48px;
    padding: 24px 26px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--panel-subtle);
  }

  .article-toc-title {
    color: var(--text);
    font-size: 14px;
    font-weight: 700;
  }

  .article-toc ol {
    columns: 2;
    column-gap: 36px;
    margin: 16px 0 0;
    padding-left: 22px;
  }

  .article-toc ol.has-explicit-numbers {
    list-style: none;
    padding-left: 0;
  }

  .article-toc li {
    break-inside: avoid;
    margin: 7px 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.55;
  }

  .article-toc a {
    color: inherit;
    font-size: inherit;
    text-decoration: none;
  }

  .article-toc a:hover {
    color: var(--cyan);
  }

  @media (max-width: 600px) {

    .article-support {
      grid-template-columns: 1fr;
      gap: 18px;
      padding: 22px;
    }

    .article-support-link {
      width: 100%;
      white-space: normal;
    }

    .article-toc {
      padding: 20px;
    }

    .article-toc ol {
      columns: 1;
    }
  }
</style>
