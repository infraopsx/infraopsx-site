---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SiteSearch from '../../components/search/SiteSearch.astro';
---

<BaseLayout
  title="Search InfraOpsX"
  description="Search InfraOpsX technical articles, infrastructure tools, case studies and portfolio work."
  lang="en"
  canonicalPath="/search/"
  enPath="/search/"
  zhPath="/zh/search/"
  noindex={true}
>
  <Header locale="en" switchHref="/zh/search/" />

  <main>
    <SiteSearch locale="en" />
  </main>

  <Footer locale="en" />
</BaseLayout>
