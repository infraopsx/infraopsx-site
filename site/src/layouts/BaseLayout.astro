---
import '../styles/global.css';

type PagefindType = 'Article' | 'Tool' | 'Case Study' | 'Portfolio';

const {
  title = 'InfraOpsX',
  description = 'Linux, Docker, Kubernetes and infrastructure engineering.',
  lang = 'en',
  canonicalPath = '/',
  enPath = '/',
  zhPath = '/zh/',
  pagefindType,
  noindex = false
} = Astro.props as {
  title?: string;
  description?: string;
  lang?: string;
  canonicalPath?: string;
  enPath?: string;
  zhPath?: string;
  pagefindType?: PagefindType;
  noindex?: boolean;
};

const site = 'https://infra.oeax.de';

const canonicalUrl = new URL(canonicalPath, site).toString();
const enUrl = new URL(enPath, site).toString();
const zhUrl = new URL(zhPath, site).toString();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{title}</title>
    <meta
      name="description"
      content={description}
      data-pagefind-default-meta="description[content]"
    />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <meta name="theme-color" content="#07111f" />
    <script is:inline>
      (() => {
        const storageKey = 'infraopsx-theme';
        const preferences = ['system', 'light', 'dark'];
        const root = document.documentElement;
        const media = window.matchMedia('(prefers-color-scheme: dark)');
        const themeColor = document.querySelector('meta[name="theme-color"]');
        let preference = 'system';

        const readPreference = () => {
          try {
            const stored = window.localStorage.getItem(storageKey);
            return preferences.includes(stored) ? stored : 'system';
          } catch {
            return 'system';
          }
        };

        const syncChoices = () => {
          document.querySelectorAll('[data-theme-choice]').forEach((choice) => {
            choice.setAttribute(
              'aria-pressed',
              String(choice.dataset.themeChoice === preference)
            );
          });
        };

        const applyPreference = (nextPreference) => {
          preference = preferences.includes(nextPreference)
            ? nextPreference
            : 'system';
          const theme = preference === 'system'
            ? (media.matches ? 'dark' : 'light')
            : preference;

          root.dataset.theme = theme;
          root.dataset.themePreference = preference;
          themeColor?.setAttribute(
            'content',
            theme === 'dark' ? '#07111f' : '#f6f8fb'
          );
          syncChoices();
        };

        applyPreference(readPreference());
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', syncChoices, { once: true });
        }

        const syncMenuState = (menu) => {
          menu.querySelector('summary')?.setAttribute(
            'aria-expanded',
            String(menu.open)
          );
        };
        const initializeMenus = () => {
          document.querySelectorAll('details[data-theme-menu]').forEach((menu) => {
            menu.addEventListener('toggle', () => syncMenuState(menu));
            syncMenuState(menu);
          });
        };
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initializeMenus, { once: true });
        } else {
          initializeMenus();
        }

        const handleSystemChange = () => {
          if (preference === 'system') applyPreference('system');
        };
        if (media.addEventListener) {
          media.addEventListener('change', handleSystemChange);
        } else {
          media.addListener(handleSystemChange);
        }

        window.addEventListener('storage', (event) => {
          if (event.key === storageKey || event.key === null) {
            applyPreference(readPreference());
          }
        });

        document.addEventListener('click', (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;

          document.querySelectorAll('details[data-theme-menu="desktop"][open]')
            .forEach((menu) => {
              if (!menu.contains(target)) menu.open = false;
            });

          const choice = target.closest('[data-theme-choice]');
          if (!choice || !preferences.includes(choice.dataset.themeChoice)) return;

          const nextPreference = choice.dataset.themeChoice;
          try {
            window.localStorage.setItem(storageKey, nextPreference);
          } catch {
            // Keep the in-page preference even when storage is unavailable.
          }
          applyPreference(nextPreference);

          const desktopMenu = choice.closest('details[data-theme-menu="desktop"]');
          if (desktopMenu) {
            desktopMenu.open = false;
            desktopMenu.querySelector('summary')?.focus();
          }
        });

        document.addEventListener('keydown', (event) => {
          if (event.key !== 'Escape') return;
          document.querySelectorAll('details[data-theme-menu][open]').forEach((menu) => {
            const shouldRestoreFocus = menu.contains(document.activeElement);
            menu.open = false;
            if (shouldRestoreFocus) menu.querySelector('summary')?.focus();
          });
        });
      })();
    </script>

    <link rel="canonical" href={canonicalUrl} />

    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="zh-CN" href={zhUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={lang === 'zh-CN' ? 'InfraOpsX 技术文章' : 'InfraOpsX Technical Articles'}
      href={lang === 'zh-CN' ? '/zh/rss.xml' : '/rss.xml'}
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="InfraOpsX" />

    <meta name="twitter:card" content="summary" />
  </head>

  <body
    data-pagefind-filter={pagefindType ? `type:${pagefindType}` : undefined}
    data-pagefind-meta={pagefindType ? `type:${pagefindType}` : undefined}
  >
    <slot />
  </body>
</html>
