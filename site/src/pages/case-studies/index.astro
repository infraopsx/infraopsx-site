---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const cases = [
  {
    title: 'Kubernetes Scheduling Failure',
    area: 'Kubernetes · Scheduling',
    problem: 'A workload remained Pending and could not be scheduled across a six-node cluster.',
    diagnosis: 'Scheduler events showed two nodes excluded by affinity rules and four nodes rejected because of CPU requests.',
    outcome: 'The problem was reduced from a generic Pending state to a concrete set of scheduling constraints, making the corrective path clear.',
    href: '/case-studies/kubernetes-pod-pending/'
  },
  {
    title: 'Rook Ceph RBD FailedMount Recovery',
    area: 'Kubernetes · Rook Ceph · Storage',
    problem: 'A stateful Pod was stuck in ContainerCreating while CSI reported that the RBD image was still being used.',
    diagnosis: 'Scanning all RBD nodeplugins found the target image mapped on a CSI node.',
    outcome: 'After the recorded mount check, umount and RBD unmap, CSI mapped the volume again and the Pod recovered.',
    href: '/case-studies/rook-ceph-rbd-failedmount/'
  },
  {
    title: 'Patroni Replica Lag and PostgreSQL WAL Retention',
    area: 'PostgreSQL · Patroni · Replication',
    problem: 'A Patroni replica lagged by roughly 230 GiB while pg_wal usage remained high.',
    diagnosis: 'The investigation distinguishes the observed replica lag from the retention mechanisms to verify: replication slots, archiving and WAL settings.',
    outcome: 'The guide documents checks for an actionable decision without claiming replica lag alone proves why WAL remains on disk.',
    href: '/blog/postgresql-pg-wal-growth-patroni-replication-lag/'
  },
  {
    title: 'Kubernetes iowait Traced Through Ceph RBD',
    area: 'Kubernetes · Ceph RBD · Performance',
    problem: 'A Kubernetes node showed high iowait while local disk throughput appeared modest.',
    diagnosis: 'D-state threads, CSI mappings, iostat and OSD metrics traced the latency into the RBD-to-OSD storage path.',
    outcome: 'Ceph-side latency was demonstrated, but the underlying hypervisor or physical storage root cause was not established.',
    href: '/blog/kubernetes-ceph-rbd-high-iowait-latency/'
  }
];
---

<BaseLayout
  title="Kubernetes, Ceph & PostgreSQL Case Studies | InfraOpsX"
  description="Anonymized infrastructure troubleshooting case studies across Kubernetes, PostgreSQL, Ceph, Docker and Linux."
  lang="en"
  canonicalPath="/case-studies/"
  enPath="/case-studies/"
  zhPath="/zh/case-studies/"
>
  <Header locale="en" switchHref="/zh/case-studies/" />

  <main>
    <section class="showcase-hero">
      <div class="container">
        <span class="section-label">CASE STUDIES</span>
        <h1>How infrastructure incidents were investigated.</h1>
        <p>
          Anonymized examples from real infrastructure work. The focus is not on
          the company or environment name, but on evidence, diagnosis steps,
          confirmed findings and the limits of what could be established.
        </p>
      </div>
    </section>

    <section class="showcase-section" data-seo-entry-links>
      <div class="container showcase-grid">
        {cases.map((item, index) => (
          <article class={`showcase-card ${item.href ? 'showcase-card-linked' : ''}`}>
            <div class="showcase-kicker">0{index + 1} · {item.area}</div>
            <h2>{item.title}</h2>

            <div class="case-block">
              <span>Problem</span>
              <p>{item.problem}</p>
            </div>

            <div class="case-block">
              <span>Diagnosis</span>
              <p>{item.diagnosis}</p>
            </div>

            <div class="case-block">
              <span>Outcome</span>
              <p>{item.outcome}</p>
            </div>

            {item.href && (
              <a class="case-read-more" href={item.href}>
                Read the detailed investigation →
              </a>
            )}
          </article>
        ))}
      </div>
    </section>
  </main>

  <Footer locale="en" />
</BaseLayout>
