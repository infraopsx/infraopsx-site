---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const modules = import.meta.glob('./*.md', { eager: true }) as Record<string, any>;

const posts = Object.values(modules)
  .map((post) => {
    const fm = post.frontmatter ?? {};
    return {
      title: fm.title,
      description: fm.description,
      date: new Date(fm.pubDate),
      href: fm.enPath,
      tags: fm.tags ?? []
    };
  })
  .filter((post) => post.title && post.href && !Number.isNaN(post.date.getTime()))
  .sort((a, b) => b.date.getTime() - a.date.getTime());

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric'
  });
---

<BaseLayout
  title="Technical Articles | InfraOpsX"
  description="Practical technical notes about Linux, Docker, Kubernetes and infrastructure troubleshooting."
  lang="en"
  canonicalPath="/blog/"
  enPath="/blog/"
  zhPath="/zh/blog/"
>
  <Header locale="en" switchHref="/zh/blog/" />

  <main>
    <section class="blog-hero">
      <div class="container">
        <div class="blog-title-row">
          <div>
            <span class="section-label">TECHNICAL ARTICLES</span>
            <h1>Real problems. Practical notes.</h1>
          </div>

          <a class="rss-link" href="/rss.xml">
            RSS Feed ↗
          </a>
        </div>

        <p>
          Troubleshooting notes, deployment guides and anonymized infrastructure
          case studies from Linux, Docker, Kubernetes, networking and storage.
        </p>
      </div>
    </section>

    <section class="posts">
      <div class="container post-list">
        {posts.map((post) => (
          <a class="post-card" href={post.href}>
            <div class="post-meta">{formatDate(post.date)}</div>
            <h2>{post.title}</h2>
            <p>{post.description}</p>

            <div class="post-tags">
              {post.tags.map((tag: string) => <span>{tag}</span>)}
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>

  <Footer locale="en" />
</BaseLayout>
