---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const services = [
  {
    title: 'Docker 与自托管应用部署',
    text: '使用 Docker 和 Docker Compose 部署或迁移自托管及容器化应用，并配置数据持久化、反向代理和 HTTPS。'
  },
  {
    title: 'Kubernetes 部署与故障排查',
    text: '部署 Kubernetes 工作负载，并排查调度、资源配置、Service、Ingress 和 CSI 存储等问题。'
  },
  {
    title: 'Linux 与基础设施故障排查',
    text: '结合日志、监控指标和系统状态，排查 Linux 服务、文件系统、磁盘 I/O、存储、网络及基础设施运行异常。'
  },
  {
    title: '监控与可观测性',
    text: '使用 Prometheus 和 Grafana，为服务器、容器及基础设施指标构建实用的监控视图。'
  }
];

const skills = [
  'Linux',
  'Docker',
  'Docker Compose',
  'Kubernetes',
  'Nginx',
  '网络',
  '存储',
  'Prometheus',
  'Grafana',
  '基础设施'
];
---

<BaseLayout
  title="InfraOpsX | Linux、Docker 与 Kubernetes 基础设施"
  description="专注于 Linux、Docker、Kubernetes、部署、故障排查与基础设施工程。"
  lang="zh-CN"
  canonicalPath="/zh/"
  enPath="/"
  zhPath="/zh/"
>
  <Header locale="zh" />

  <main>
    <section class="hero">
      <div class="hero-glow"></div>

      <div class="container hero-content">
        <div class="eyebrow">
          Linux · Docker · Kubernetes · 基础设施
        </div>

        <h1>
          让基础设施保持
          <span>清晰、可靠、可理解。</span>
        </h1>

        <p class="hero-text">
          面向 Linux 服务器、容器、Kubernetes 和自托管系统，
          提供实用的部署、故障排查与基础设施解决方案。
        </p>

        <div class="hero-actions">
          <a class="button primary" href="#services">查看服务</a>
          <a class="button secondary" href="#articles">技术文章</a>
        </div>

        <div class="stack">
          <span>Linux</span>
          <span>Docker</span>
          <span>Kubernetes</span>
          <span>Nginx</span>
          <span>Prometheus</span>
          <span>Grafana</span>
        </div>
      </div>
    </section>

    <section id="services" class="section">
      <div class="container">
        <div class="section-heading">
          <span class="section-label">服务</span>
          <h2>以明确的结果为目标。</h2>

          <p>
            关注真正可用的部署与运维方案，而不是为了复杂而复杂。
          </p>
        </div>

        <div class="cards">
          {services.map((service, index) => (
            <article class="card">
              <div class="card-number">0{index + 1}</div>
              <h3>{service.title}</h3>
              <p>{service.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="expertise" class="section section-dark">
      <div class="container split">
        <div>
          <span class="section-label">技术能力</span>
          <h2>建立在真实基础设施之上。</h2>

          <p class="large-copy">
            工作范围涵盖 Linux、容器、Kubernetes、网络、存储与监控，
            重点是结合日志、监控指标和系统状态跨层定位实际问题，
            并帮助服务以清晰、可维护的方式运行在生产环境中。
          </p>
        </div>

        <div class="skill-grid">
          {skills.map((skill) => (
            <div class="skill">{skill}</div>
          ))}
        </div>
      </div>
    </section>

    <section id="work" class="section">
      <div class="container">
        <div class="section-heading">
          <span class="section-label">工作方式</span>
          <h2>先定位，再修改。</h2>
        </div>

        <div class="workflow">
          <div>
            <strong>01</strong>
            <h3>理解</h3>
            <p>首先确认真实需求、运行环境以及现有约束。</p>
          </div>

          <div>
            <strong>02</strong>
            <h3>诊断</h3>
            <p>结合日志、监控指标和系统状态寻找真正的根因。</p>
          </div>

          <div>
            <strong>03</strong>
            <h3>实施</h3>
            <p>采用尽可能简单、可靠且清晰的方案解决问题。</p>
          </div>

          <div>
            <strong>04</strong>
            <h3>验证</h3>
            <p>验证最终结果，并保证环境仍然清晰、可维护。</p>
          </div>
        </div>
      </div>
    </section>

    <section id="articles" class="section section-accent">
      <div class="container articles-intro">
        <div>
          <span class="section-label">技术记录</span>
          <h2>真实问题，实用记录。</h2>

          <p>
            记录来自真实 Linux、Kubernetes、存储和数据库环境的故障排查过程，
            保留关键命令、现场证据和定位思路，方便在类似环境中复用。
          </p>
        </div>

        <div class="article-preview">
          <span>精选文章</span>

          <ul>
            <li>
              <a href="/zh/blog/kubernetes-ceph-rbd-high-iowait-latency/">
                Kubernetes iowait 很高但吞吐不高：Ceph RBD 与 OSD 延迟排查
              </a>
            </li>
            <li>
              <a href="/zh/blog/rook-ceph-rbd-image-still-being-used-failedmount/">
                Kubernetes + Rook Ceph：FailedMount 提示 RBD image is still being used 怎么排查
              </a>
            </li>
            <li>
              <a href="/zh/blog/postgresql-pg-wal-growth-patroni-replication-lag/">
                PostgreSQL pg_wal 一直增长：Patroni 副本落后 230GB 时该怎么排查
              </a>
            </li>
          </ul>

          <p class="article-all"><a href="/zh/blog/">查看全部技术文章 →</a></p>
        </div>
      </div>
    </section>

    <section class="cta">
      <div class="container">
        <div class="cta-box">
          <div>
            <span class="section-label">INFRAOPSX</span>
            <h2>好的部署，应该平静而可靠。</h2>
            <p>可靠的系统、清晰的配置以及可持续维护的基础设施。</p>
          </div>

          <div class="cta-actions">
            <div class="status">
              <span class="status-dot"></span>
              项目制技术服务
            </div>
            <a class="button primary" href="/zh/contact/">联系我 →</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer locale="zh" />
</BaseLayout>
