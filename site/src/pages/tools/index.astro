---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ToolsExplorer from '../../components/tools/ToolsExplorer.astro';
---

<BaseLayout
  title="Infrastructure Tools | InfraOpsX"
  description="Practical browser-based tools for Ceph, Kubernetes and infrastructure planning."
  lang="en"
  canonicalPath="/tools/"
  enPath="/tools/"
  zhPath="/zh/tools/"
>
  <Header locale="en" switchHref="/zh/tools/" />

  <main>
    <section class="tools-hero">
      <div class="container">
        <div class="tools-breadcrumb">
          <a href="/">Home</a>
          <span>/</span>
          <span>Tools</span>
        </div>

        <span class="section-label">INFRAOPSX TOOLS</span>
        <h1>Practical infrastructure tools for real-world systems.</h1>
        <p>Browser-based tools for Kubernetes, storage, and everyday infrastructure work.</p>
      </div>
    </section>

    <ToolsExplorer locale="en" />
  </main>

  <Footer locale="en" />
</BaseLayout>
