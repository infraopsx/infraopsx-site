---
import {
  CEPH_DEFAULTS,
  calculateCephCapacity,
  formatCephCapacity,
  formatCephNumber,
  secondaryCephUnit
} from '../../lib/cephCapacity.mjs';

const { locale = 'en' } = Astro.props;
const isZh = locale === 'zh';
const defaults = CEPH_DEFAULTS;
const initial = calculateCephCapacity(defaults);
if (!initial.ok) throw new Error('Invalid default Ceph capacity configuration');

const unit = defaults.unit;
const secondary = secondaryCephUnit(unit);
const initialSummary = isZh
  ? '集群原始容量为 ' + formatCephCapacity(initial.rawBytes, unit) +
    '。采用 3 副本时，理论可用容量为 ' + formatCephCapacity(initial.theoreticalBytes, unit) +
    '。按 15% 的用户预留比例计算，规划目标为 ' + formatCephCapacity(initial.planningBytes, unit) + '。'
  : 'The cluster has ' + formatCephCapacity(initial.rawBytes, unit) +
    ' of raw capacity. With three replicas, theoretical usable capacity is ' +
    formatCephCapacity(initial.theoreticalBytes, unit) + '. After a 15% user-selected reserve, ' +
    'the planning target is ' + formatCephCapacity(initial.planningBytes, unit) + '.';
---

<section
  class="ceph-calculator"
  data-ceph-calculator
  data-locale={locale}
>
  <div class="calculator-grid">
    <form class="calculator-form" data-calculator-form novalidate>
      <div class="calculator-mode" role="radiogroup" aria-label={isZh ? '容量模式' : 'Capacity mode'}>
        <label class="mode-option is-active" data-mode-option="replicated">
          <input
            type="radio"
            name={`ceph-mode-${locale}`}
            value="replicated"
            checked
          />
          <span>Replicated</span>
        </label>

        <label class="mode-option" data-mode-option="ec">
          <input
            type="radio"
            name={`ceph-mode-${locale}`}
            value="ec"
          />
          <span>Erasure Coding</span>
        </label>
      </div>

      <div class="form-fields">
        <label class="field">
          <span>{isZh ? 'OSD 数量' : 'OSD Count'}</span>
          <input data-input="osdCount" type="number" min="1" step="1" value={defaults.osdCount} />
        </label>

        <label class="field">
          <span>{isZh ? '单个 OSD 容量' : 'Capacity per OSD'}</span>
          <input data-input="capacity" type="number" min="0.01" step="any" value={defaults.capacity} />
        </label>

        <label class="field">
          <span>{isZh ? '容量单位' : 'Capacity Unit'}</span>
          <select data-input="unit">
            <option value="GB">GB — {isZh ? '十进制' : 'Decimal'}</option>
            <option value="GiB">GiB — {isZh ? '二进制' : 'Binary'}</option>
            <option value="TB" selected={defaults.unit === 'TB'}>TB — {isZh ? '十进制，硬盘厂商常用' : 'Decimal, commonly used by disk vendors'}</option>
            <option value="TiB">TiB — {isZh ? '二进制，Linux/Ceph 常用' : 'Binary, commonly used by Linux/Ceph'}</option>
          </select>
        </label>

        <div class="field-group" data-field-group="replicated">
          <label class="field">
            <span>Replication Size</span>
            <input data-input="replication" type="number" min="1" step="1" value={defaults.replication} />
          </label>
        </div>

        <div class="field-group" data-field-group="ec" hidden>
          <div class="field-row">
            <label class="field">
              <span>k</span>
              <input data-input="k" type="number" min="1" step="1" value={defaults.k} />
            </label>

            <label class="field">
              <span>m</span>
              <input data-input="m" type="number" min="1" step="1" value={defaults.m} />
            </label>
          </div>
        </div>

        <label class="field">
          <span>Reserve (%)</span>
          <input data-input="reserve" type="number" min="0" max="99.99" step="any" value={defaults.reserve} />
        </label>
      </div>


      <details class="ceph-advanced" data-topology-details>
        <summary>{isZh ? '高级选项：基础放置条件检查（可选）' : 'Advanced: basic placement check (optional)'}</summary>
        <p class="ceph-advanced-help">
          {isZh
            ? '不确定就保持“不检查”。这里仅检查 OSD / Host 数量，不读取 CRUSH 配置，也无法保证真实数据放置。'
            : 'Leave this unchecked if unsure. This only checks OSD/host counts, not real CRUSH rules or actual data placement.'}
        </p>
        <label class="field">
          <span>{isZh ? 'CRUSH Failure Domain' : 'CRUSH failure domain'}</span>
          <select data-input="failureDomain">
            <option value="unknown" selected>{isZh ? '不清楚 / 不检查' : 'I do not know / skip check'}</option>
            <option value="host">Host</option>
            <option value="osd">OSD</option>
          </select>
        </label>
        <div class="field-group ceph-host-field" data-host-count-group hidden>
          <label class="field">
            <span>{isZh ? '可用 Host 数量' : 'Number of eligible hosts'}</span>
            <input data-input="hostCount" type="number" min="1" step="1" placeholder={isZh ? '例如 3' : 'e.g. 3'} />
          </label>
        </div>
      </details>

      <div class="calculator-error" data-calculator-error role="alert" hidden></div>

      <button class="button primary calculator-submit" type="submit">
        {isZh ? '计算容量' : 'Calculate capacity'}
      </button>
    </form>

    <div class="calculator-output" aria-live="polite">
      <div class="summary-block">
        <span class="section-label">{isZh ? '容量分析' : 'CAPACITY ANALYSIS'}</span>
        <h2>{isZh ? '分析摘要' : 'Analysis Summary'}</h2>
        <p data-summary>{initialSummary}</p>
      </div>

      <div class="results-block">
        <div class="results-heading">
          <div>
            <span class="section-label">{isZh ? '容量结果' : 'CAPACITY RESULTS'}</span>
            <h2>{isZh ? '计算结果' : 'Results'}</h2>
          </div>
          <span class="result-mode" data-result-mode>Replicated</span>
        </div>

        <dl class="result-list">
          <div class="result-row result-row-primary">
            <dt>Raw Capacity</dt>
            <dd>
              <strong data-result="raw">{formatCephCapacity(initial.rawBytes, unit)}</strong>
              <small data-result-secondary="raw">≈ {formatCephCapacity(initial.rawBytes, secondary)}</small>
            </dd>
          </div>

          <div class="result-row">
            <dt>Theoretical Usable Capacity</dt>
            <dd>
              <strong data-result="theoretical">{formatCephCapacity(initial.theoreticalBytes, unit)}</strong>
              <small data-result-secondary="theoretical">≈ {formatCephCapacity(initial.theoreticalBytes, secondary)}</small>
            </dd>
          </div>

          <div class="result-row result-row-recommended">
            <dt>Planning Capacity After Reserve</dt>
            <dd>
              <strong data-result="planning">{formatCephCapacity(initial.planningBytes, unit)}</strong>
              <small data-result-secondary="planning">≈ {formatCephCapacity(initial.planningBytes, secondary)}</small>
            </dd>
          </div>

          <div class="result-row">
            <dt>Data Efficiency</dt>
            <dd><strong data-result="efficiency">{formatCephNumber(initial.efficiency * 100)}%</strong></dd>
          </div>

          <div class="result-row">
            <dt>Redundancy Overhead</dt>
            <dd>
              <strong data-result="overhead">{formatCephCapacity(initial.overheadBytes, unit)}</strong>
              <small data-result-secondary="overhead">≈ {formatCephCapacity(initial.overheadBytes, secondary)}</small>
            </dd>
          </div>
        </dl>

        <p class="ceph-result-note" data-placement-status>
          {isZh
            ? '未检查 Host / CRUSH 放置条件；目前只核验了 OSD 数量。'
            : 'Host / CRUSH placement is not checked. Only OSD count has been checked.'}
        </p>
        <p class="ceph-result-note">
          {isZh
            ? '规划容量不等于 Ceph 的 MAX AVAIL，也不是保证可以安全写入的数据量。'
            : 'Planning capacity is not Ceph MAX AVAIL or a guarantee of safely writable space.'}
        </p>
      </div>
    </div>
  </div>

  <p class="calculator-privacy">
    {isZh
      ? '所有计算均在浏览器本地完成，不会上传配置或输入数据。'
      : 'All calculations run locally in your browser. No configuration or input data is uploaded.'}
  </p>
</section>

<script>
  import {
    calculateCephCapacity,
    formatCephCapacity,
    formatCephNumber,
    secondaryCephUnit
  } from '../../lib/cephCapacity.mjs';

  const root = document.querySelector('[data-ceph-calculator]');

  if (root) {
    const isZh = root.dataset.locale === 'zh';
    const form = root.querySelector('[data-calculator-form]');
    const error = root.querySelector('[data-calculator-error]');
    const details = root.querySelector('[data-topology-details]');
    const modeInputs = [...root.querySelectorAll('input[name^="ceph-mode-"]')];
    const modeOptions = [...root.querySelectorAll('[data-mode-option]')];
    const fields = [...root.querySelectorAll('[data-input]')];
    const replicatedGroup = root.querySelector('[data-field-group="replicated"]');
    const ecGroup = root.querySelector('[data-field-group="ec"]');
    const hostGroup = root.querySelector('[data-host-count-group]');
    const resultMode = root.querySelector('[data-result-mode]');
    const summary = root.querySelector('[data-summary]');
    const placementStatus = root.querySelector('[data-placement-status]');

    const resultNodes = Object.fromEntries(
      [...root.querySelectorAll('[data-result]')].map((node) => [node.dataset.result, node])
    );
    const secondaryNodes = Object.fromEntries(
      [...root.querySelectorAll('[data-result-secondary]')].map((node) => [node.dataset.resultSecondary, node])
    );

    const input = (name) => root.querySelector('[data-input="' + name + '"]');
    const selectedMode = () => modeInputs.find((item) => item.checked)?.value || 'replicated';

    const readValues = () => ({
      mode: selectedMode(),
      osdCount: input('osdCount').value,
      capacity: input('capacity').value,
      unit: input('unit').value,
      replication: input('replication').value,
      k: input('k').value,
      m: input('m').value,
      reserve: input('reserve').value,
      failureDomain: input('failureDomain').value,
      hostCount: input('hostCount').value
    });

    const setError = (message = '') => {
      error.textContent = message;
      error.hidden = !message;
    };

    const clearInvalid = () => fields.forEach((field) => field.removeAttribute('aria-invalid'));

    const updateVisibleControls = () => {
      const mode = selectedMode();
      replicatedGroup.hidden = mode !== 'replicated';
      ecGroup.hidden = mode !== 'ec';
      hostGroup.hidden = input('failureDomain').value !== 'host';
      modeOptions.forEach((option) => option.classList.toggle('is-active', option.dataset.modeOption === mode));
    };

    const staleMessage = isZh
      ? '输入已更改，请点击“计算容量”查看新结果。'
      : 'Inputs changed. Select Calculate capacity to update the results.';

    const markStale = () => {
      Object.values(resultNodes).forEach((node) => { node.textContent = '—'; });
      Object.values(secondaryNodes).forEach((node) => { node.textContent = ''; });
      resultMode.textContent = '—';
      summary.textContent = staleMessage;
      placementStatus.textContent = staleMessage;
    };

    const fieldLabels = isZh
      ? { osdCount: 'OSD 数量', capacity: '单个 OSD 容量', unit: '容量单位', replication: 'Replication Size', k: 'k', m: 'm', reserve: 'Reserve', failureDomain: 'Failure Domain', hostCount: 'Host 数量' }
      : { osdCount: 'OSD count', capacity: 'Capacity per OSD', unit: 'Capacity unit', replication: 'Replication size', k: 'k', m: 'm', reserve: 'Reserve', failureDomain: 'Failure domain', hostCount: 'Host count' };

    const explainError = (result) => {
      const label = fieldLabels[result.field] || result.field;
      if (result.code === 'required') return isZh ? label + '不能为空。' : label + ' is required.';
      if (result.code === 'positiveInteger') return isZh ? label + '必须是大于 0 的整数。' : label + ' must be a positive integer.';
      if (result.code === 'positive') return isZh ? label + '必须大于 0。' : label + ' must be greater than zero.';
      if (result.code === 'reserveRange') return isZh ? 'Reserve 必须大于等于 0，且小于 100%。' : 'Reserve must be at least 0% and less than 100%.';
      if (result.code === 'exceedsOSDs') return isZh ? '副本数或 EC 分片总数不能超过 OSD 数量。' : 'Replicas or EC chunks cannot exceed the OSD count.';
      if (result.code === 'hostsExceedOSDs') return isZh ? 'Host 数量不能超过所填写的 OSD 数量。' : 'Host count cannot exceed the OSD count provided.';
      if (result.code === 'insufficientHosts') return isZh
        ? 'Host 数量不足：Host failure domain 需要至少与副本数或 EC 分片总数一样多的 Host。'
        : 'Too few hosts: the host failure domain requires at least as many hosts as replicas or EC chunks.';
      if (result.code === 'outOfRange') return isZh ? '容量数值太大或太小，无法可靠计算，请调整输入。' : 'Capacity magnitude is outside the reliable calculation range.';
      return isZh ? '请为 ' + label + ' 输入有效数值。' : 'Enter a valid value for ' + label + '.';
    };

    const displayFailure = (result) => {
      markStale();
      clearInvalid();
      const field = input(result.field);
      if (field) {
        field.setAttribute('aria-invalid', 'true');
        if (result.field === 'hostCount' || result.field === 'failureDomain') details.open = true;
        field.focus();
      }
      setError(explainError(result));
    };

    const render = (result) => {
      const unit = result.values.unit;
      const secondaryUnit = secondaryCephUnit(unit);
      const values = result.values;
      resultMode.textContent = values.mode === 'replicated'
        ? 'Replicated'
        : 'EC ' + values.k + '+' + values.m;

      for (const [key, bytes] of [
        ['raw', result.rawBytes],
        ['theoretical', result.theoreticalBytes],
        ['planning', result.planningBytes],
        ['overhead', result.overheadBytes]
      ]) {
        resultNodes[key].textContent = formatCephCapacity(bytes, unit);
        secondaryNodes[key].textContent = '≈ ' + formatCephCapacity(bytes, secondaryUnit);
      }
      resultNodes.efficiency.textContent = formatCephNumber(result.efficiency * 100) + '%';

      const modeText = values.mode === 'replicated'
        ? (isZh ? 'Replication Size ' : 'replication size ') + values.replication
        : 'EC ' + values.k + '+' + values.m;

      summary.textContent = isZh
        ? '原始容量 ' + formatCephCapacity(result.rawBytes, unit) +
          '，采用 ' + modeText + ' 后，理论可用容量 ' +
          formatCephCapacity(result.theoreticalBytes, unit) +
          '；按 ' + formatCephNumber(values.reserve) + '% 预留，规划容量为 ' +
          formatCephCapacity(result.planningBytes, unit) + '。'
        : 'Raw capacity is ' + formatCephCapacity(result.rawBytes, unit) +
          '. With ' + modeText + ', theoretical usable capacity is ' +
          formatCephCapacity(result.theoreticalBytes, unit) +
          '. After a ' + formatCephNumber(values.reserve) + '% reserve, the planning target is ' +
          formatCephCapacity(result.planningBytes, unit) + '.';

      if (result.placementCheck === 'not-checked') {
        placementStatus.textContent = isZh
          ? '未检查 Host / CRUSH 放置条件；目前只核验了 OSD 数量。'
          : 'Host / CRUSH placement is not checked. Only OSD count has been checked.';
      } else {
        placementStatus.textContent = isZh
          ? '基础 ' + values.failureDomain.toUpperCase() + ' 数量条件已满足；仍未验证 CRUSH 规则、设备分布和真实容量。'
          : 'Basic ' + values.failureDomain.toUpperCase() +
            ' count condition passed. CRUSH rules, placement distribution and actual capacity are not verified.';
      }
      if (values.mode === 'replicated' && values.replication === 1) {
        placementStatus.textContent += isZh ? ' 注意：单副本没有冗余保护。' : ' Warning: size=1 provides no replica redundancy.';
      }

      clearInvalid();
      setError('');
    };

    const calculate = () => {
      const result = calculateCephCapacity(readValues());
      if (!result.ok) {
        displayFailure(result);
        return;
      }
      render(result);
    };

    modeInputs.forEach((radio) => radio.addEventListener('change', () => {
      updateVisibleControls();
      calculate();
    }));

    fields.forEach((field) => {
      field.addEventListener('input', () => {
        setError('');
        clearInvalid();
        markStale();
      });
    });

    input('unit').addEventListener('change', calculate);
    input('failureDomain').addEventListener('change', () => {
      updateVisibleControls();
      markStale();
      setError('');
      clearInvalid();
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      calculate();
    });

    updateVisibleControls();
  }
</script>
