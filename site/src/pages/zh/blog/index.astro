---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const modules = import.meta.glob('./*.md', { eager: true }) as Record<string, any>;

const posts = Object.values(modules)
  .map((post) => {
    const fm = post.frontmatter ?? {};
    return {
      title: fm.title,
      description: fm.description,
      date: new Date(fm.pubDate),
      href: fm.zhPath,
      tags: fm.tags ?? []
    };
  })
  .filter((post) => post.title && post.href && !Number.isNaN(post.date.getTime()))
  .sort((a, b) => b.date.getTime() - a.date.getTime());

const formatDate = (date: Date) =>
  date.toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
---

<BaseLayout
  title="技术文章 | InfraOpsX"
  description="Linux、Docker、Kubernetes 与基础设施故障排查相关的实用技术记录。"
  lang="zh-CN"
  canonicalPath="/zh/blog/"
  enPath="/blog/"
  zhPath="/zh/blog/"
>
  <Header locale="zh" switchHref="/blog/" />

  <main>
    <section class="blog-hero">
      <div class="container">
        <div class="blog-title-row">
          <div>
            <span class="section-label">技术文章</span>
            <h1>真实问题，实用记录。</h1>
          </div>

          <a class="rss-link" href="/zh/rss.xml">
            RSS 订阅 ↗
          </a>
        </div>

        <p>
          记录 Linux、Docker、Kubernetes、网络、存储和生产环境中的
          故障排查、部署实践以及匿名化案例。
        </p>
      </div>
    </section>

    <section class="posts">
      <div class="container post-list">
        {posts.map((post) => (
          <a class="post-card" href={post.href}>
            <div class="post-meta">{formatDate(post.date)}</div>
            <h2>{post.title}</h2>
            <p>{post.description}</p>

            <div class="post-tags">
              {post.tags.map((tag: string) => <span>{tag}</span>)}
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>

  <Footer locale="zh" />
</BaseLayout>
