---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const areas = [
  ['Linux Infrastructure', 'System administration, services, storage, networking and production diagnostics.'],
  ['Docker & Self-hosted', 'Containerized deployment, Docker Compose, persistence, reverse proxy and HTTPS.'],
  ['Kubernetes', 'Workloads, scheduling, services, ingress, storage and troubleshooting.'],
  ['Monitoring', 'Prometheus, Grafana and practical infrastructure visibility.']
];

const pipeline = [
  'Feature branch',
  'Pull Request',
  'CI Docker build',
  'Merge to main',
  'Publish to GHCR',
  'Deploy to Netcup',
  'Cloudflare edge'
];
---

<BaseLayout
  title="Portfolio | InfraOpsX"
  description="Selected InfraOpsX infrastructure work across Linux, Docker, Kubernetes, monitoring and troubleshooting."
  lang="en"
  canonicalPath="/portfolio/"
  enPath="/portfolio/"
  zhPath="/zh/portfolio/"
  pagefindType="Portfolio"
>
  <Header locale="en" switchHref="/zh/portfolio/" />

  <main data-pagefind-body>
    <section class="showcase-hero">
      <div class="container">
        <span class="section-label">PORTFOLIO</span>
        <h1>Selected infrastructure work and technical focus.</h1>
        <p>
          A concise view of the systems and problem areas I work with, backed by
          technical articles, public source code and anonymized case studies.
        </p>
      </div>
    </section>

    <section class="showcase-section">
      <div class="container">

        <article class="featured-project">
          <div class="featured-project-copy">
            <span class="section-label">FEATURED PROJECT</span>
            <h2>InfraOpsX Website & CI/CD</h2>
            <p>
              This website is also a live infrastructure project. The source is
              managed in Git, changes are reviewed through pull requests, Docker
              builds are validated in CI, production images are published to
              GitHub Container Registry, and successful builds are deployed
              automatically to a Netcup VPS.
            </p>

            <div class="project-stack">
              <span>Astro</span>
              <span>Docker</span>
              <span>Nginx</span>
              <span>GitHub Actions</span>
              <span>GHCR</span>
              <span>Netcup</span>
              <span>Cloudflare</span>
            </div>

            <div class="project-actions" data-pagefind-ignore>
              <a
                class="button primary"
                href="https://github.com/infraopsx/infraopsx-site"
                target="_blank"
                rel="noreferrer"
              >
                View source on GitHub
              </a>

              <a class="button secondary" href="/case-studies/">
                View case studies
              </a>
            </div>
          </div>

          <div class="pipeline-card">
            <span class="pipeline-title">Production delivery flow</span>
            <div class="pipeline">
              {pipeline.map((step, index) => (
                <>
                  <div class="pipeline-step">
                    <span>{String(index + 1).padStart(2, '0')}</span>
                    <strong>{step}</strong>
                  </div>
                  {index < pipeline.length - 1 && <div class="pipeline-arrow">↓</div>}
                </>
              ))}
            </div>
          </div>
        </article>

        <div class="portfolio-grid portfolio-grid-spaced">
          {areas.map(([title, text]) => (
            <article class="portfolio-card">
              <h2>{title}</h2>
              <p>{text}</p>
            </article>
          ))}
        </div>

        <div class="portfolio-links" data-pagefind-ignore>
          <a class="button primary" href="/case-studies/">View case studies</a>
          <a class="button secondary" href="/blog/">Read technical articles</a>
        </div>
      </div>
    </section>
  </main>

  <Footer locale="en" />
</BaseLayout>
